{
  "manifest_version": 3,
  "name": "UK Visa Sponsor Checker by WorkCV",
  "description": "See which employers hold a UK visa sponsor licence, with badges on job listings from the official Home Office register.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://workcv.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://uk.indeed.com/*",
        "https://www.reed.co.uk/*",
        "https://www.totaljobs.com/*",
        "https://www.cv-library.co.uk/*",
        "https://www.glassdoor.co.uk/*"
      ],
      "js": ["employers.js", "sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UK Visa Sponsor Checker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://workcv.co.uk/chrome/uk-visa-sponsor-checker"
}
