# Saved-CV reminders remain off until both product and legal approval are recorded.
SAVED_CV_REMINDER_ENABLED=false
SAVED_CV_REMINDER_LEGAL_APPROVED=false

# AI CV import
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
