{
  "name": "oneoff-uk-cv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "package:distribution": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-distribution-assets.ps1",
    "generate:public-sample": "node scripts/generate-public-cv-sample.mjs",
    "report:growth": "node scripts/report-growth.mjs",
    "db:prepare:growth": "node scripts/prepare-growth-schema.mjs",
    "verify:indexing": "node scripts/verify-indexing.mjs",
    "cleanup:growth-events": "node scripts/cleanup-growth-events.mjs",
    "test:content": "node --no-warnings --test --experimental-strip-types tests/content-authority-pages.test.ts",
    "test:long-tail": "node --no-warnings --test --experimental-strip-types tests/long-tail-seo-pages.test.ts",
    "type-check": "tsc --noEmit",
    "test:ats": "node --no-warnings --test --experimental-strip-types tests/ats-keyword-checker.test.ts",
    "test:tools": "node --no-warnings --test --experimental-strip-types tests/*.test.ts",
    "test:pdf-runtime": "node scripts/pdf-runtime-smoke.mjs",
    "test:pdf-parity": "node tests/pdf-parity.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "clsx": "^2.0.0",
    "docx": "^9.7.1",
    "lucide-react": "^0.303.0",
    "mammoth": "^1.12.0",
    "next": "^14.2.35",
    "nodemailer": "^8.0.11",
    "openai": "^6.42.0",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.21.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
}
